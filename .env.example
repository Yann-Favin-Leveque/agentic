# ============================================================
# AGENTIC-HELPER - Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in your actual values
# For Spring Boot, these will be auto-loaded as properties
# ============================================================

# ============================================================
# AI PROVIDER INSTANCES (REQUIRED)
# ============================================================
# JSON array of provider configurations
# Supports: OpenAI, Azure OpenAI, Anthropic (Claude), Azure Anthropic (Claude)
OPENAI_INSTANCES=[{"id":"openai-main","url":"https://api.openai.com","key":"sk-xxx","models":"gpt-4o,gpt-4o-mini,text-embedding-3-small,dall-e-3","provider":"openai","enabled":true},{"id":"azure-1","url":"https://my-resource.openai.azure.com","key":"azure-key-xxx","models":"gpt-4o","provider":"azure","apiVersion":"2024-08-01-preview","enabled":true},{"id":"anthropic-main","url":"https://api.anthropic.com","key":"sk-ant-xxx","models":"claude-opus-4-5,claude-sonnet-4-5,claude-haiku-4-5","provider":"anthropic","enabled":true},{"id":"azure-anthropic","url":"https://my-resource.services.ai.azure.com","key":"azure-key-xxx","models":"claude-sonnet-4-5","provider":"azure-anthropic","apiVersion":"2023-06-01","enabled":true}]

# ============================================================
# PROVIDER FILTERING (OPTIONAL)
# ============================================================
# Comma-separated list of providers to enable
# Leave empty or unset to enable all providers
# Options: openai, azure, azure-anthropic, anthropic
# ENABLED_PROVIDERS=openai,azure

# ============================================================
# AGENT CONFIGURATION
# ============================================================
# Package containing your AgentResult classes
AGENT_RESULT_CLASS_PACKAGE=com.example.agents.results

# Path to agent JSON definition files
AGENT_JSON_FOLDER_PATH=src/main/resources/agents

# ============================================================
# RATE LIMITING & RETRY CONFIGURATION
# ============================================================
# Maximum requests per second (default: 5)
REQUESTS_PER_SECOND=5

# Maximum retry attempts for failed requests (default: 3)
MAX_RETRIES=3

# Default response timeout in milliseconds (default: 120000 = 2 min)
DEFAULT_RESPONSE_TIMEOUT=120000

# Base delay for exponential backoff in milliseconds (default: 10000 = 10 sec)
RETRY_BASE_DELAY_MS=10000

# Delay for rate limit errors in milliseconds (default: 60000 = 1 min)
RATE_LIMIT_DELAY_MS=60000

# Delay for 502 errors in milliseconds (default: 300000 = 5 min)
ERROR_502_DELAY_MS=300000

# ============================================================
# LOGGING CONFIGURATION
# ============================================================

# --- DEVELOPMENT ENVIRONMENT ---
# Verbose logging for debugging

# Agentic-Helper library (your code)
LOGGING_LEVEL_IO_GITHUB_YANNFAVINLEVEQUE_AGENTIC=DEBUG

# HTTP Client (cleverclient) - suppress verbose HTTP logs
LOGGING_LEVEL_IO_GITHUB_SASHIRESTELA_CLEVERCLIENT=ERROR

# --- PRODUCTION ENVIRONMENT ---
# Use INFO level in production to reduce log volume
# Uncomment these for production:
# LOGGING_LEVEL_IO_GITHUB_YANNFAVINLEVEQUE_AGENTIC=INFO
# LOGGING_LEVEL_IO_GITHUB_SASHIRESTELA_CLEVERCLIENT=ERROR

# --- GRANULAR LOGGING (OPTIONAL) ---
# Fine-tune logging per package if needed

# Agent services (request/response logs)
# LOGGING_LEVEL_IO_GITHUB_YANNFAVINLEVEQUE_AGENTIC_AGENT_SERVICE=INFO

# Support utilities
# LOGGING_LEVEL_IO_GITHUB_YANNFAVINLEVEQUE_AGENTIC_SUPPORT=WARN

# --- FRAMEWORK LOGGING ---
# Reduce noise from common frameworks

# SLF4J
LOGGING_LEVEL_ORG_SLF4J=WARN

# Logback
LOGGING_LEVEL_CH_QOS_LOGBACK=WARN

# Jackson (JSON serialization)
LOGGING_LEVEL_COM_FASTERXML_JACKSON=WARN

# Spring Framework (if using Spring Boot)
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=INFO
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=DEBUG  # Uncomment to see HTTP requests

# Hibernate (if using JPA)
# LOGGING_LEVEL_ORG_HIBERNATE=INFO
# LOGGING_LEVEL_ORG_HIBERNATE_SQL=DEBUG  # Uncomment to see SQL queries

# ============================================================
# SPRING BOOT APPLICATION (if applicable)
# ============================================================
# SERVER_PORT=8080
# SPRING_APPLICATION_NAME=my-app

# ============================================================
# NOTES
# ============================================================
# 1. Logback configuration (logback.xml) applies to ALL logs:
#    - All logs are compressed to single line (newlines replaced with " | ")
#    - Works for JSON, multiline text, stack traces, etc.
#
# 2. Log levels hierarchy:
#    TRACE < DEBUG < INFO < WARN < ERROR
#    Setting DEBUG will show DEBUG, INFO, WARN, ERROR
#    Setting INFO will show INFO, WARN, ERROR (no DEBUG/TRACE)
#
# 3. Structured logging format (examples):
#    → REQUEST START | Agent: WeatherAgent (id:weather) | Model: gpt-4o | Instance: openai-main | Thread: NEW | Prompt: What's the weather?
#    ← RESPONSE END | Agent: WeatherAgent (id:weather) | Model: gpt-4o | Instance: openai-main | Thread: thread_123 | Response: The weather is...
#    → EMBEDDING START | Model: text-embedding-3-small | Instance: openai-main | Input: Text to embed...
#    ← EMBEDDING END | Model: text-embedding-3-small | Instance: openai-main | Dimensions: 1536
#
# 4. For Spring Boot, these env vars are automatically converted to properties:
#    LOGGING_LEVEL_IO_GITHUB_YANNFAVINLEVEQUE_AGENTIC=DEBUG
#    becomes:
#    logging.level.io.github.yannfavinleveque.agentic=DEBUG
